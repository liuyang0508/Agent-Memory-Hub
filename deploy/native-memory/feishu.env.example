# AMH 组织记忆 Hub —— 飞书登录配置
#
# 安装位置：/etc/amh-native/feishu.env
# 权限：root:amh-native 0640（systemd 以 amh-native 身份读取）
# 生效方式：systemctl restart amh-native
#
# 凭证/公开URL或明确的企业标识缺失时，不开放浏览器登录。
# 管理页（https://你的域名/native/v1/admin）也能填这三项，环境变量优先。

# 飞书开放平台 → 凭证与基础信息 → App ID
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx

# 飞书开放平台 → 凭证与基础信息 → App Secret
FEISHU_APP_SECRET=

# 本实例对外的 HTTPS 地址，不带结尾斜杠。
# 回调地址由它推导：<AMH_HUB_PUBLIC_URL>/native/v1/auth/feishu/callback
# 这个地址必须与飞书后台「安全设置 → 重定向 URL」逐字符一致。
AMH_HUB_PUBLIC_URL=https://amh.example.com

# 组织标识，决定成员归属；每家企业自己填自己的。
FEISHU_TENANT=linkcrux

# 必须明确允许的飞书企业，逗号分隔 tenant_key；也可在管理员页面设置单一企业。
# 新部署留空且管理页未配置时拒绝登录，不由首个访客决定企业归属。
# 旧部署已保存的企业 pin 保留；迁移已有身份见 scope-feishu-identities。
FEISHU_ALLOWED_TENANT_KEYS=

# 可选：独立管理页入口关闭开关（true 表示关闭）。
# 关闭后 /native/v1/admin 仍返回页面，但没有任何管理令牌时无法使用；
# 需要彻底禁用请直接不签发管理令牌。
